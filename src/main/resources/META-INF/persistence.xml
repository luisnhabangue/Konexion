<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="iXitique" transaction-type="RESOURCE_LOCAL">

        <!-- Implementação JPA -->
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>



        <class>model.Group</class>
        <class>model.Cycle</class>
        <class>model.Contribution</class>
        <class>model.User</class>
        <class>model.UserGroup</class>
        <class>model.PaymentTransaction</class>

        <properties>

            <!-- ============================= -->
            <!-- Configuração da base de dados -->
            <!-- ============================= -->

            <property name="jakarta.persistence.jdbc.driver"
                      value="com.mysql.cj.jdbc.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/ixitique?allowPublicKeyRetrieval=true&amp;useSSL=false&amp;serverTimezone=Africa/Maputo"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="root"/>

            <property name="jakarta.persistence.jdbc.password"
                      value="alteza77"/>


            <!-- ============================= -->
            <!-- Configuração do Hibernate -->
            <!-- ============================= -->

            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.MySQLDialect"/>

            <!-- Cria/actualiza as tabelas automaticamente -->
            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>

            <!-- Mostrar SQL no terminal -->
            <property name="hibernate.show_sql"
                      value="true"/>

            <!-- Formatar SQL -->
            <property name="hibernate.format_sql"
                      value="true"/>

        </properties>
    </persistence-unit>

</persistence>