<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane minHeight="620.0" minWidth="920.0" prefHeight="760.0" prefWidth="1180.0"
           styleClass="auth-scene" stylesheets="@../css/style.css"
           xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.RegisterController">

    <children>
        <Circle fill="rgba(255,255,255,0.13)" radius="175.0" mouseTransparent="true"
                translateX="-455.0" translateY="-260.0" StackPane.alignment="CENTER"/>
        <Circle fill="rgba(255,183,3,0.16)" radius="125.0" mouseTransparent="true"
                translateX="485.0" translateY="300.0" StackPane.alignment="CENTER"/>
        <Circle fill="transparent" radius="215.0" stroke="rgba(255,255,255,0.18)"
                strokeWidth="2.0" mouseTransparent="true" translateX="500.0"
                translateY="-300.0" StackPane.alignment="CENTER"/>
        <StackPane mouseTransparent="true" styleClass="auth-background-coin"
                   translateY="205.0" StackPane.alignment="CENTER_LEFT">
            <Label styleClass="auth-coin-label" text="MT"/>
        </StackPane>
        <VBox alignment="CENTER" mouseTransparent="true" spacing="8.0"
              styleClass="auth-growth-decoration" translateY="190.0"
              StackPane.alignment="CENTER_RIGHT">
            <HBox alignment="BOTTOM_CENTER" spacing="5.0">
                <Region styleClass="auth-growth-bar, auth-growth-bar-short"/>
                <Region styleClass="auth-growth-bar, auth-growth-bar-medium"/>
                <Region styleClass="auth-growth-bar, auth-growth-bar-tall"/>
                <Region styleClass="auth-growth-bar, auth-growth-bar-medium"/>
            </HBox>
            <Label styleClass="auth-decoration-label" text="POUPANÇA"/>
        </VBox>
        <BorderPane maxHeight="700.0" maxWidth="1020.0" minHeight="580.0" minWidth="900.0"
                    prefHeight="680.0" prefWidth="1020.0" styleClass="auth-window">

            <!-- PAINEL LATERAL -->
            <left>
                <StackPane minWidth="360.0" prefWidth="420.0"
                           styleClass="auth-visual, auth-visual-left" BorderPane.alignment="CENTER">

                    <children>
                        <Circle fill="transparent" radius="250.0" stroke="rgba(255,255,255,0.07)" strokeWidth="1.5" translateX="150.0" translateY="-120.0" StackPane.alignment="TOP_RIGHT" />

                        <Circle fill="transparent" radius="200.0" stroke="rgba(255,255,255,0.07)" strokeWidth="1.5" translateX="-130.0" translateY="100.0" StackPane.alignment="BOTTOM_LEFT" />

                        <VBox alignment="TOP_LEFT" maxWidth="420.0" spacing="22.0">

                            <padding>
                                <Insets bottom="26.0" left="32.0" right="28.0" top="28.0" />
                            </padding>

                            <children>
                                <!-- LOGÓTIPO -->
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <StackPane prefHeight="38.0" prefWidth="42.0" styleClass="icon">
                                            <children>
                                                <Label style="-fx-text-fill: #0F5257;                                                               -fx-font-weight: bold;                                                               -fx-font-size: 19px;" text="K" />
                                            </children>
                                        </StackPane>

                                        <Label style="-fx-text-fill: white;                                                       -fx-font-size: 23px;                                                       -fx-font-weight: bold;" text="Konexion" />
                                    </children>
                                </HBox>

                                <!-- MENSAGEM PRINCIPAL -->
                                <VBox alignment="CENTER_LEFT" spacing="16.0" VBox.vgrow="ALWAYS">

                                    <children>
                                        <Label style="-fx-background-color: rgba(111,221,165,0.15);                                                       -fx-text-fill: #B9EED2;                                                       -fx-padding: 7px 11px;                                                       -fx-background-radius: 14px;                                                       -fx-font-size: 10px;                                                       -fx-font-weight: bold;" text="POUPAR JUNTOS, CRESCER JUNTOS" />

                                        <Label style="-fx-text-fill: white;                                                       -fx-font-size: 32px;                                                       -fx-font-weight: bold;                                                       -fx-line-spacing: 3px;" text="A sua comunidade.&#10;Os seus objetivos.&#10;Um futuro melhor." wrapText="true" />

                                        <Label maxWidth="340.0" style="-fx-text-fill: rgba(255,255,255,0.75);                                                       -fx-font-size: 13px;                                                       -fx-line-spacing: 3px;" text="Organize os seus grupos de poupança, acompanhe contribuições e alcance objetivos em conjunto." wrapText="true" />

                                        <!-- CARTÕES ILUSTRATIVOS -->
                                        <Pane maxWidth="350.0" prefHeight="175.0" prefWidth="350.0">

                                            <children>
                                                <VBox layoutX="175.0" layoutY="48.0" prefHeight="85.0" prefWidth="145.0" spacing="10.0" styleClass="visual-card-back">
                                                    <padding>
                                                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                                                    </padding>
                                                    <children>
                                                        <Label style="-fx-text-fill: rgba(255,255,255,0.65);                                                                       -fx-font-size: 10px;" text="Próximo ciclo" />
                                                        <Label style="-fx-text-fill: white;                                                                       -fx-font-size: 17px;                                                                       -fx-font-weight: bold;" text="25 Jun" />
                                                    </children>
                                                </VBox>

                                                <VBox layoutX="10.0" layoutY="12.0" prefHeight="132.0" prefWidth="240.0" spacing="9.0" styleClass="visual-card-front">
                                                    <padding>
                                                        <Insets bottom="12.0" left="15.0" right="15.0" top="15.0" />
                                                    </padding>
                                                    <children>
                                                        <Label style="-fx-text-fill: #69787B;                                                                       -fx-font-size: 10px;" text="Poupança do grupo" />

                                                        <Label style="-fx-text-fill: #182426;                                                                       -fx-font-size: 21px;                                                                       -fx-font-weight: bold;" text="35.000,00 MT" />

                                                        <StackPane maxHeight="7.0" prefHeight="7.0" style="-fx-background-color: #E4ECEC;                                                                           -fx-background-radius: 5px;">
                                                            <children>
                                                                <Region maxWidth="145.0" prefWidth="145.0" style="-fx-background-color: #0F5257;                                                                                -fx-background-radius: 5px;" StackPane.alignment="CENTER_LEFT" />
                                                            </children>
                                                        </StackPane>

                                                        <Label style="-fx-text-fill: #69787B;                                                                       -fx-font-size: 10px;" text="Meta: 71% alcançada" />
                                                    </children>
                                                </VBox>

                                                <StackPane layoutX="0.0" layoutY="0.0" prefHeight="42.0" prefWidth="42.0" styleClass="coin-badge">
                                                    <children>
                                                        <Label style="-fx-text-fill: #6F4E00;                                                                       -fx-font-weight: bold;                                                                       -fx-font-size: 11px;" text="MT" />
                                                    </children>
                                                </StackPane>
                                            </children>
                                        </Pane>
                                    </children>
                                </VBox>

                                <Label style="-fx-text-fill: rgba(255,255,255,0.55);                                               -fx-font-size: 10px;" text="Seguro · Transparente · Feito para Moçambique" wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </left>

            <!-- FORMULÁRIO DE REGISTO -->
            <center>
                <StackPane styleClass="auth-form-pane" BorderPane.alignment="CENTER">

                    <children>
                        <VBox alignment="CENTER_LEFT" maxWidth="500.0" spacing="10.0">

                            <padding>
                                <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
                            </padding>

                            <children>
                                <!-- VOLTAR -->
                                <Hyperlink fx:id="linkVoltarLogin" style="-fx-text-fill: #69787B;                                                   -fx-font-size: 12px;                                                   -fx-border-color: transparent;                                                   -fx-padding: 0 0 8px 0;" text="← Voltar ao login" />

                                <!-- CABEÇALHO -->
                                <Label style="-fx-font-size: 28px;                                               -fx-font-weight: bold;                                               -fx-text-fill: #182426;" text="Criar a sua conta" />

                                <Label style="-fx-font-size: 13px;                                               -fx-text-fill: #69787B;" text="Comece hoje a poupar em comunidade." wrapText="true" />

                                <!-- INDICADOR DE PASSOS -->
                                <HBox alignment="CENTER_LEFT" spacing="9.0" style="-fx-padding: 12px 0 14px 0;">
                                    <children>
                                        <StackPane minHeight="25.0" minWidth="25.0" style="-fx-background-color: #0F5257;                                                           -fx-background-radius: 50px;">
                                            <children>
                                                <Label style="-fx-text-fill: white;                                                               -fx-font-size: 11px;                                                               -fx-font-weight: bold;" text="1" />
                                            </children>
                                        </StackPane>

                                        <Label style="-fx-font-size: 11px;                                                       -fx-font-weight: bold;                                                       -fx-text-fill: #182426;" text="Dados pessoais" />

                                        <Separator opacity="0.4" HBox.hgrow="ALWAYS" />

                                        <StackPane minHeight="25.0" minWidth="25.0" style="-fx-background-color: #DFE6E7;                                                           -fx-background-radius: 50px;">
                                            <children>
                                                <Label style="-fx-text-fill: #69787B;                                                               -fx-font-size: 11px;" text="2" />
                                            </children>
                                        </StackPane>

                                        <Label style="-fx-font-size: 11px;                                                       -fx-text-fill: #69787B;" text="Credenciais" />
                                    </children>
                                </HBox>

                                <!-- NOMES -->
                                <HBox spacing="14.0">
                                    <children>
                                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style="-fx-font-size: 12px;                                                               -fx-font-weight: bold;                                                               -fx-text-fill: #182426;" text="Primeiros nomes" />

                                                <MFXTextField fx:id="txtPrimeirosNomes" floatMode="DISABLED" maxWidth="Infinity" prefHeight="43.0" promptText="Ex.: João" styleClass="mfx-text-field" HBox.hgrow="ALWAYS" />
                                                <Label fx:id="lblFirstNameError" managed="false" styleClass="field-error" visible="false" wrapText="true" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style="-fx-font-size: 12px;                                                               -fx-font-weight: bold;                                                               -fx-text-fill: #182426;" text="Apelidos" />

                                                <MFXTextField fx:id="txtApelidos" floatMode="DISABLED" maxWidth="Infinity" prefHeight="43.0" promptText="Ex.: Silva" styleClass="mfx-text-field" HBox.hgrow="ALWAYS" />
                                                <Label fx:id="lblLastNameError" managed="false" styleClass="field-error" visible="false" wrapText="true" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- DOCUMENTO -->
                                <VBox spacing="6.0">
                                    <children>
                                        <Label style="-fx-font-size: 12px;                                                       -fx-font-weight: bold;                                                       -fx-text-fill: #182426;" text="NUIT / BI (opcional)" />

                                        <MFXTextField fx:id="txtDocumento" floatMode="DISABLED" maxWidth="Infinity" prefHeight="43.0" promptText="Pode preencher depois para verificar a conta" styleClass="mfx-text-field" />
                                        <Label fx:id="lblDocumentError" managed="false" styleClass="field-error" visible="false" wrapText="true" />
                                        <Label style="-fx-font-size: 10px; -fx-text-fill: #69787B;" text="Após aprovação do KYC, poderá criar e gerir os seus grupos; nos outros grupos participa como membro." wrapText="true" />
                                    </children>
                                </VBox>

                                <!-- GÉNERO E DATA DE NASCIMENTO -->
                                <HBox spacing="14.0">
                                    <children>
                                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style="-fx-font-size: 12px;                                                               -fx-font-weight: bold;                                                               -fx-text-fill: #182426;" text="Género" />

                                                <ComboBox fx:id="cmbGenero" maxWidth="Infinity" prefHeight="43.0" promptText="Selecione" styleClass="mfx-text-field" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style="-fx-font-size: 12px;                                                               -fx-font-weight: bold;                                                               -fx-text-fill: #182426;" text="Data de nascimento" />

                                                <DatePicker fx:id="dpDataNascimento" maxWidth="Infinity" prefHeight="43.0" promptText="Dia / mês / ano" HBox.hgrow="ALWAYS" />
                                                <Label fx:id="lblBirthDateError" managed="false" styleClass="field-error" visible="false" wrapText="true" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- TELEFONE -->
                                <VBox spacing="6.0">
                                    <children>
                                        <Label style="-fx-font-size: 12px;                                                       -fx-font-weight: bold;                                                       -fx-text-fill: #182426;" text="Telefone (M-Pesa / E-Mola)" />

                                        <MFXTextField fx:id="txtTelefone" floatMode="DISABLED" maxWidth="Infinity" prefHeight="43.0" promptText="+258 84 XXX XXXX" styleClass="mfx-text-field" />
                                        <Label fx:id="lblPhoneError" managed="false" styleClass="field-error" visible="false" wrapText="true" />
                                    </children>
                                </VBox>

                                <!-- CONTINUAR -->
                                <MFXButton fx:id="btnContinuar" maxWidth="Infinity" prefHeight="46.0" styleClass="button-primary" text="Continuar  →">
                                    <VBox.margin>
                                        <Insets top="8.0" />
                                    </VBox.margin>
                                </MFXButton>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </center>
        </BorderPane>
    </children>
</StackPane>
