<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.GroupsController"
            fitToWidth="true" hbarPolicy="NEVER"
            styleClass="page-scroll" stylesheets="@app.css">

    <VBox styleClass="page" spacing="24">
        <HBox alignment="CENTER_LEFT" spacing="16">
            <VBox spacing="6">
                <Label text="Os meus grupos" styleClass="page-title"/>
                <Label text="Acompanhe os seus xitiques e descubra novos grupos."
                       styleClass="page-sub" wrapText="true"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnCreateNewGroup" text="Criar grupo"
                    styleClass="btn, btn-primary"/>
        </HBox>

        <VBox spacing="14">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Grupos em que participa" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox styleClass="compact-search" alignment="CENTER_LEFT" spacing="9">
                    <StackPane styleClass="ico-box">
                        <SVGPath styleClass="ico"
                                 content="M4,11 A7,7 0 1 0 18,11 A7,7 0 1 0 4,11 M20,20 L16,16"/>
                    </StackPane>
                    <TextField fx:id="groupSearchField" styleClass="search-input"
                               promptText="Pesquisar grupos..." HBox.hgrow="ALWAYS"/>
                </HBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <HBox styleClass="segments" spacing="0">
                    <ToggleButton fx:id="filterAll" text="Todos" styleClass="segment" selected="true">
                        <toggleGroup>
                            <ToggleGroup fx:id="filterGroup"/>
                        </toggleGroup>
                    </ToggleButton>
                    <ToggleButton fx:id="filterActive" text="Ativos" styleClass="segment"
                                  toggleGroup="$filterGroup"/>
                    <ToggleButton fx:id="filterFinished" text="Concluídos" styleClass="segment"
                                  toggleGroup="$filterGroup"/>
                </HBox>
                <Label text="Selecione um grupo para consultar os seus ciclos."
                       styleClass="section-sub" wrapText="true"/>
            </HBox>

            <GridPane fx:id="groupsGrid" hgap="16" vgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.34" hgrow="ALWAYS"/>
                </columnConstraints>
            </GridPane>
        </VBox>

        <VBox styleClass="card, admin-section" spacing="12">
            <VBox spacing="5">
                <Label text="Descobrir grupos públicos" styleClass="section-title"/>
                <Label text="Pode participar em grupos públicos, mesmo que a sua conta ainda não esteja verificada."
                       styleClass="section-sub" wrapText="true"/>
            </VBox>
            <VBox fx:id="publicGroupRows" spacing="8"/>
        </VBox>
    </VBox>
</ScrollPane>
