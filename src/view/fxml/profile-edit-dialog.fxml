<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="520.0" spacing="16.0" styleClass="modal" stylesheets="@app.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ProfileEditDialogController">
    <padding>
        <Insets bottom="22.0" left="24.0" right="24.0" top="22.0"/>
    </padding>
    <children>
        <VBox spacing="5.0">
            <Label text="Editar perfil" styleClass="modal-title"/>
            <Label text="Atualize os seus dados pessoais num só lugar." styleClass="modal-sub"/>
        </VBox>

        <VBox spacing="6.0">
            <Label text="Primeiro nome" styleClass="field-label"/>
            <HBox styleClass="field-control">
                <TextField fx:id="txtFirstName" styleClass="field-input" promptText="Primeiro nome"
                           maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <VBox spacing="6.0">
            <Label text="Apelido" styleClass="field-label"/>
            <HBox styleClass="field-control">
                <TextField fx:id="txtLastName" styleClass="field-input" promptText="Apelido"
                           maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <VBox spacing="6.0">
            <Label text="Telefone" styleClass="field-label"/>
            <HBox styleClass="field-control">
                <TextField fx:id="txtPhone" styleClass="field-input" promptText="+258 84 123 4567"
                           maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <VBox spacing="6.0">
            <Label text="Email" styleClass="field-label"/>
            <Label fx:id="lblEmail" styleClass="info-value"/>
            <Label text="A alteração do email requer confirmação e ainda não está disponível."
                   styleClass="section-sub" wrapText="true"/>
        </VBox>

        <VBox spacing="6.0">
                <Label text="Username" styleClass="field-label"/>
                <Label fx:id="lblUsername" styleClass="info-value"/>
        </VBox>
        <VBox spacing="6.0">
                <Label text="NUIT / BI" styleClass="field-label"/>
                <Label fx:id="lblDocument" styleClass="info-value"/>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button fx:id="btnCancel" text="Cancelar" styleClass="btn, btn-secondary"/>
            <Button fx:id="btnSave" text="Guardar alterações" styleClass="btn, btn-primary"/>
        </HBox>
    </children>
</VBox>
