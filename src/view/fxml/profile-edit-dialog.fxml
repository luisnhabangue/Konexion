<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="520.0" spacing="16.0" styleClass="modal" stylesheets="@app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ProfileEditDialogController">
    <padding>
        <Insets bottom="22.0" left="24.0" right="24.0" top="22.0" />
    </padding>
    <children>
        <VBox spacing="5.0">
            <Label styleClass="modal-title" text="Editar perfil" />
            <Label styleClass="modal-sub" text="Atualize os seus dados pessoais num só lugar." />
        </VBox>

        <VBox spacing="6.0">
            <Label styleClass="field-label" text="Primeiro nome" />
            <HBox alignment="CENTER_LEFT" styleClass="field-control">
                <TextField fx:id="txtFirstName" maxWidth="Infinity" promptText="Primeiro nome" styleClass="field-input" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>

        <VBox spacing="6.0">
            <Label styleClass="field-label" text="Apelido" />
            <HBox alignment="CENTER_LEFT" styleClass="field-control">
                <TextField fx:id="txtLastName" maxWidth="Infinity" promptText="Apelido" styleClass="field-input" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>

        <VBox spacing="6.0">
            <Label styleClass="field-label" text="Telefone" />
            <HBox alignment="CENTER_LEFT" styleClass="field-control">
                <TextField fx:id="txtPhone" maxWidth="Infinity" promptText="+258 84 123 4567" styleClass="field-input" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>

        <VBox spacing="6.0">
            <Label styleClass="field-label" text="Email" />
            <Label fx:id="lblEmail" styleClass="info-value" />
            <Label styleClass="section-sub" text="A alteração do email requer confirmação e ainda não está disponível." wrapText="true" />
        </VBox>

        <VBox spacing="6.0">
                <Label styleClass="field-label" text="Username" />
                <Label fx:id="lblUsername" styleClass="info-value" />
        </VBox>
        <VBox spacing="6.0">
                <Label styleClass="field-label" text="NUIT / BI" />
                <Label fx:id="lblDocument" styleClass="info-value" />
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button fx:id="btnCancel" styleClass="btn, btn-secondary" text="Cancelar" />
            <Button fx:id="btnSave" styleClass="btn, btn-primary" text="Guardar alterações" />
        </HBox>
    </children>
</VBox>
