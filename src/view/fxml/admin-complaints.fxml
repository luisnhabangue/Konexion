<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="page-scroll" stylesheets="@app.css"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AdminDashboardController">
    <VBox spacing="18" styleClass="page">
        <VBox spacing="5">
            <Label styleClass="page-title" text="Denúncias"/>
            <Label styleClass="page-sub" text="Analise e resolva as denúncias submetidas pelos utilizadores."/>
        </VBox>
        <VBox spacing="10" styleClass="card, admin-section">
            <Label styleClass="section-title" text="Denúncias por analisar"/>
            <VBox fx:id="reportRows" spacing="8"/>
        </VBox>
    </VBox>
</ScrollPane>
