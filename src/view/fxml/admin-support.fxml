<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.ComboBox?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.ListView?>
        <?import javafx.scene.control.ScrollPane?>
        <?import javafx.scene.control.Separator?>
        <?import javafx.scene.control.TextArea?>
        <?import javafx.scene.layout.BorderPane?>
        <?import javafx.scene.layout.HBox?>
        <?import javafx.scene.layout.Priority?>
        <?import javafx.scene.layout.Region?>
        <?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.AdminSupportController"
            styleClass="page">

    <top>
        <VBox spacing="12">
            <padding>
                <Insets top="24" right="28" bottom="20" left="28"/>
            </padding>

            <Button text="←  Voltar ao painel"
                    onAction="#backToDashboard"
                    styleClass="btn, btn-secondary"
                    maxWidth="180"/>

            <VBox spacing="5">
                <Label text="Centro de suporte"
                       style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-weight: bold;"/>

                <Label text="Gestão de pedidos"
                       style="-fx-font-size: 27px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

                <Label text="Acompanha os pedidos, responde aos utilizadores e atualiza o estado."
                       style="-fx-font-size: 13px; -fx-text-fill: #64748b;"
                       wrapText="true"/>
            </VBox>

            <Separator/>
        </VBox>
    </top>

    <center>
        <HBox spacing="22">
            <padding>
                <Insets top="4" right="28" bottom="28" left="28"/>
            </padding>

            <!-- Lista de pedidos -->
            <VBox spacing="14"
                  prefWidth="330"
                  minWidth="270"
                  HBox.hgrow="NEVER"
                  styleClass="card">

                <padding>
                    <Insets top="20" right="18" bottom="18" left="18"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Pedidos recebidos"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="SUPORTE"
                           style="-fx-background-color: #ecfdf5; -fx-text-fill: #047857; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 5 8 5 8; -fx-background-radius: 6;"/>
                </HBox>

                <Label text="Seleciona um pedido para consultar os detalhes."
                       style="-fx-text-fill: #64748b; -fx-font-size: 12px;"
                       wrapText="true"/>

                <Label fx:id="lblEmpty"
                       text="Ainda não existem pedidos."
                       visible="false"
                       managed="false"
                       style="-fx-text-fill: #64748b; -fx-padding: 14;"
                       wrapText="true"/>

                <ListView fx:id="ticketList"
                          VBox.vgrow="ALWAYS"
                          prefHeight="500"
                          style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;"/>
            </VBox>

            <!-- Detalhes e resposta -->
            <ScrollPane fitToWidth="true"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;"
                        pannable="true">

                <content>
                    <VBox spacing="20"
                          styleClass="card">

                        <padding>
                            <Insets top="24" right="24" bottom="24" left="24"/>
                        </padding>

                        <VBox spacing="5">
                            <Label text="Detalhes do pedido"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

                            <Label text="Consulta a mensagem original antes de responder."
                                   style="-fx-font-size: 12px; -fx-text-fill: #64748b;"
                                   wrapText="true"/>
                        </VBox>

                        <Separator/>

                        <!-- Informação do pedido -->
                        <VBox spacing="7">
                            <Label text="UTILIZADOR"
                                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>

                            <Label fx:id="lblRequester"
                                   text="Seleciona um pedido"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"
                                   wrapText="true"/>
                        </VBox>

                        <VBox spacing="7">
                            <Label text="ASSUNTO"
                                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>

                            <Label fx:id="lblSubject"
                                   style="-fx-font-size: 14px; -fx-text-fill: #0f172a;"
                                   wrapText="true"/>
                        </VBox>

                        <VBox spacing="7">
                            <Label text="DATA DE ENVIO"
                                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>

                            <Label fx:id="lblDate"
                                   style="-fx-font-size: 13px; -fx-text-fill: #475569;"/>
                        </VBox>

                        <!-- Mensagem original -->
                        <VBox spacing="10"
                              style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">

                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16"/>
                            </padding>

                            <Label text="Mensagem do utilizador"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>

                            <Label fx:id="lblMessage"
                                   style="-fx-font-size: 13px; -fx-text-fill: #475569;"
                                   wrapText="true"/>
                        </VBox>

                        <!-- Resposta anterior -->
                        <VBox spacing="10"
                              style="-fx-background-color: #f0fdf4; -fx-background-radius: 10;">

                            <padding>
                                <Insets top="15" right="16" bottom="15" left="16"/>
                            </padding>

                            <Label text="Resposta anterior"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #166534;"/>

                            <Label fx:id="lblCurrentResponse"
                                   text="Ainda não foi enviada uma resposta."
                                   style="-fx-font-size: 13px; -fx-text-fill: #166534;"
                                   wrapText="true"/>
                        </VBox>

                        <Separator/>

                        <!-- Formulário de resposta -->
                        <VBox spacing="7">
                            <Label text="A tua resposta"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

                            <Label text="Escreve uma resposta clara e útil para o utilizador."
                                   style="-fx-font-size: 12px; -fx-text-fill: #64748b;"
                                   wrapText="true"/>

                            <TextArea fx:id="txtAdminResponse"
                                      promptText="Escreve aqui a resposta..."
                                      wrapText="true"
                                      prefRowCount="6"
                                      style="-fx-font-size: 13px;"
                                      VBox.vgrow="ALWAYS"/>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="Estado do pedido"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>

                            <ComboBox fx:id="cmbStatus"
                                      maxWidth="Infinity"
                                      promptText="Seleciona o estado"/>
                        </VBox>

                        <Button text="Guardar resposta e estado  →"
                                onAction="#saveResponse"
                                styleClass="btn, btn-primary"
                                maxWidth="Infinity"
                                prefHeight="44"/>
                    </VBox>
                </content>
            </ScrollPane>
        </HBox>
    </center>
</BorderPane>
