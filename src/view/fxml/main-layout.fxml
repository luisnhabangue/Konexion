<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!--
  Layout principal (sidebar + topbar + área de conteúdo).
  A navegação carrega cada página FXML dentro do StackPane "contentArea".
  O <fx:include> abaixo é só para pré-visualização - remova quando
  tratar da navegação no controller.
-->

<BorderPane prefHeight="800" prefWidth="1280" styleClass="app-shell" stylesheets="@app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainLayoutController">

    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox styleClass="sidebar">
            <HBox alignment="CENTER_LEFT" spacing="11" styleClass="brand">
                <StackPane styleClass="brand-mark">
                    <Label styleClass="brand-mark-text" text="K" />
                </StackPane>
                <Label styleClass="brand-name" text="Konexion" />
            </HBox>

            <VBox spacing="3" styleClass="nav">
                <Label styleClass="nav-label" text="MENU PRINCIPAL" />

                <Button fx:id="navDashboard" maxWidth="Infinity" styleClass="nav-item, active" text="Visão geral">
                    <graphic>
                        <StackPane styleClass="ico-box"><SVGPath content="M3,10.8 L12,3 L21,10.8 M5.5,9.5 L5.5,21 L18.5,21 L18.5,9.5 M9.5,21 L9.5,14 L14.5,14 L14.5,21" styleClass="ico" /></StackPane>
                    </graphic>
                </Button>

                <Button fx:id="navGroups" maxWidth="Infinity" styleClass="nav-item" text="Meus Xitiques">
                    <graphic>
                        <StackPane styleClass="ico-box"><SVGPath content="M16,21 L16,19 A4,4 0 0 0 12,15 L6,15 A4,4 0 0 0 2,19 L2,21 M5,7 A4,4 0 1 0 13,7 A4,4 0 1 0 5,7 M22,21 L22,19 A4,4 0 0 0 19,15.13 M16,3.13 A4,4 0 0 1 16,10.87" styleClass="ico" /></StackPane>
                    </graphic>
                </Button>

                <Button fx:id="navHistory" maxWidth="Infinity" styleClass="nav-item" text="Histórico">
                    <graphic>
                        <StackPane styleClass="ico-box"><SVGPath content="M3,12 A9,9 0 1 0 6,5.3 L3,8 M3,3 L3,8 L8,8 M12,7 L12,12 L15,14" styleClass="ico" /></StackPane>
                    </graphic>
                </Button>

                <Button fx:id="navProfile" maxWidth="Infinity" styleClass="nav-item" text="Meu perfil">
                    <graphic>
                        <StackPane styleClass="ico-box"><SVGPath content="M8,8 A4,4 0 1 0 16,8 A4,4 0 1 0 8,8 M4,21 A8,8 0 0 1 20,21" styleClass="ico" /></StackPane>
                    </graphic>
                </Button>

                <Label styleClass="nav-label, nav-label-spaced" text="PREFERÊNCIAS" />

                <Button fx:id="navSettings" maxWidth="Infinity" styleClass="nav-item" text="Configurações">
                    <graphic>
                        <StackPane styleClass="ico-box"><SVGPath content="M4,6 L20,6 M4,12 L20,12 M4,18 L20,18 M9,4 L9,8 M15,10 L15,14 M8,16 L8,20" styleClass="ico" /></StackPane>
                    </graphic>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="side-help">
                <StackPane styleClass="help-circle">
                    <Label styleClass="white-text, bold" text="?" />
                </StackPane>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label styleClass="side-help-title" text="Precisa de ajuda?" />
                    <Label styleClass="side-help-sub" text="Fale com o nosso suporte" />
                </VBox>
                <StackPane styleClass="ico-box"><SVGPath content="M5,12 L19,12 M13,6 L19,12 L13,18" styleClass="ico" /></StackPane>
            </HBox>

            <Button fx:id="btnLogout" maxWidth="Infinity" styleClass="logout" text="Terminar sessão">
                <graphic>
                    <StackPane styleClass="ico-box"><SVGPath content="M10,17 L15,12 L10,7 M15,12 L3,12 M15,4 L19,4 A2,2 0 0 1 21,6 L21,18 A2,2 0 0 1 19,20 L15,20" styleClass="ico" /></StackPane>
                </graphic>
                <VBox.margin><Insets top="11" /></VBox.margin>
            </Button>
        </VBox>
    </left>

    <!-- ================= TOPBAR + CONTEÚDO ================= -->
    <center>
        <BorderPane>
            <top>
                <HBox alignment="CENTER_LEFT" spacing="16" styleClass="topbar">
                    <HBox alignment="CENTER_LEFT" prefHeight="77.0" spacing="9" styleClass="search">
                        <StackPane styleClass="ico-box"><SVGPath content="M4,11 A7,7 0 1 0 18,11 A7,7 0 1 0 4,11 M20,20 L16,16" styleClass="ico" /></StackPane>
                        <TextField fx:id="searchField" promptText="Pesquisar grupos, transações..." styleClass="search-input" HBox.hgrow="ALWAYS" />
                        <Label styleClass="kbd" text="Ctrl K" />
                    </HBox>

                    <Region prefHeight="49.0" prefWidth="206.0" HBox.hgrow="ALWAYS" />

                    <Button fx:id="btnCreateGroup" styleClass="btn, btn-primary" text="Criar grupo">
                        <graphic>
                            <StackPane styleClass="ico-box"><SVGPath content="M12,5 L12,19 M5,12 L19,12" styleClass="ico, ico-btn" /></StackPane>
                        </graphic>
                    </Button>

                    <StackPane>
                        <Button fx:id="btnNotifications" styleClass="icon-button">
                            <graphic>
                                <StackPane styleClass="ico-box"><SVGPath content="M18,8 A6,6 0 0 0 6,8 C6,15 3,15 3,17 L21,17 C21,15 18,15 18,8 M10,21 L14,21" styleClass="ico" /></StackPane>
                            </graphic>
                        </Button>
                        <Label fx:id="lblNotificationCount" mouseTransparent="true" styleClass="notification-dot" text="3" translateX="5" translateY="-5" StackPane.alignment="TOP_RIGHT" />
                    </StackPane>

                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="user-card">
                        <StackPane styleClass="avatar, avatar-sm"><Label text="JS" /></StackPane>
                        <VBox alignment="CENTER" spacing="3">
                            <Label fx:id="lblUserName" styleClass="user-name" text="João Silva" />
                        </VBox>
                    </HBox>
                </HBox>
            </top>

            <center>
                <StackPane fx:id="contentArea" styleClass="content-area">
                    <!-- pré-visualização: remova quando a navegação estiver pronta -->
                    <fx:include source="dashboard.fxml" />
                </StackPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>
