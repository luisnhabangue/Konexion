            <Label text="02 Jun, 10:20" styleClass="t-td, c-w150"/>
            <HBox spacing="9" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <StackPane styleClass="avatar, avatar-sm"><Label text="FU"/></StackPane>
                <Label text="Família Unida" styleClass="t-name"/>
            </HBox>
            <Label text="5.000,00 MT" styleClass="t-amount, c-w130"/>
            <HBox styleClass="c-w110" alignment="CENTER_LEFT"><Label text="PAGO" styleClass="badge, badge-success"/></HBox>
            <HBox styleClass="c-w40" alignment="CENTER_RIGHT"><Button styleClass="mini-button"><graphic><StackPane styleClass="ico-box"><SVGPath styleClass="ico" content="M11,5 A1,1 0 1 0 13,5 A1,1 0 1 0 11,5 M11,12 A1,1 0 1 0 13,12 A1,1 0 1 0 11,12 M11,19 A1,1 0 1 0 13,19 A1,1 0 1 0 11,19"/></StackPane></graphic></Button></HBox>
