<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            styleClass="page-scroll" stylesheets="@app.css" fitToWidth="true" hbarPolicy="NEVER"
            fx:controller="controller.ProfileController">
    <fx:define>
        <ToggleGroup fx:id="profileTabs"/>
    </fx:define>

    <VBox styleClass="page" spacing="22">

        <VBox spacing="6">
            <Label text="Meu perfil" styleClass="page-title"/>
            <Label text="Consulte os seus dados, histórico e preferências." styleClass="page-sub"/>
        </VBox>

        <!-- ================= CARTÃO DE PERFIL ================= -->
        <VBox styleClass="profile-card">
            <Region styleClass="profile-cover"/>

            <HBox styleClass="profile-main" spacing="15" alignment="TOP_LEFT">
                <StackPane styleClass="avatar, avatar-xl, avatar-bordered" translateY="-31" minWidth="60">
                    <Label fx:id="lblProfileInitials" text="?"/>
                </StackPane>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblProfileName" text="João Silva" styleClass="profile-name"/>
                    <Label text="Dados pessoais da sua conta" styleClass="profile-since"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="CONTA ATIVA" styleClass="badge, badge-success"/>
                        <Label fx:id="lblVerificationStatus" text="POR VERIFICAR" styleClass="badge, badge-warning"/>
                        <VBox.margin><Insets top="4"/></VBox.margin>
                    </HBox>
                </VBox>
                <Button fx:id="btnEditProfile" text="Editar perfil" styleClass="btn, btn-secondary">
                    <HBox.margin><Insets top="16"/></HBox.margin>
                </Button>
            </HBox>

            <GridPane fx:id="profileInfo" styleClass="profile-info" hgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>
                <VBox spacing="6" GridPane.columnIndex="0"><Label text="Username" styleClass="info-label"/><Label fx:id="lblUsername" text="@joaosilva" styleClass="info-value"/></VBox>
                <VBox spacing="6" GridPane.columnIndex="1"><Label text="Telefone" styleClass="info-label"/><Label fx:id="lblPhone" text="+258 85 643 2210" styleClass="info-value"/></VBox>
                <VBox spacing="6" GridPane.columnIndex="2"><Label text="Email" styleClass="info-label"/><Label fx:id="lblEmail" text="joao.silva@email.co.mz" styleClass="info-value"/></VBox>
                <VBox spacing="6" GridPane.columnIndex="3"><Label text="NUIT / BI" styleClass="info-label"/><Label fx:id="lblDocument" text="1104•••••" styleClass="info-value"/></VBox>
            </GridPane>
        </VBox>

        <VBox fx:id="kycSection" styleClass="card, kyc-card" spacing="12">
            <Label text="Verificação de identidade (KYC)" styleClass="section-title"/>
            <Label text="Submeta o BI ou NUIT e fotografias para o administrador rever. A conta continua apta a participar em grupos enquanto aguarda."
                   styleClass="section-sub" wrapText="true"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtKycDocument" promptText="Número do BI ou NUIT" styleClass="field-input"
                           HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnChooseDocumentPhoto" text="Foto do documento" styleClass="btn, btn-secondary"/>
            </HBox>
            <Label fx:id="lblDocumentPhoto" text="Nenhuma foto do documento selecionada" styleClass="section-sub"
                   wrapText="true"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnChooseSelfie" text="Selecionar fotografia" styleClass="btn, btn-secondary"/>
                <Label fx:id="lblSelfiePhoto" text="Nenhuma fotografia selecionada" styleClass="section-sub"
                       wrapText="true" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnSubmitKyc" text="Enviar para aprovação" styleClass="btn, btn-primary"/>
            </HBox>
        </VBox>
        <VBox fx:id="leadershipSection" styleClass="card, kyc-card" spacing="10">
            <Label text="Pedir nomeação como chefe de grupo" styleClass="section-title"/>
            <Label text="O administrador analisa os pedidos. A nomeação dá acesso às ferramentas de gestão de grupos."
                   styleClass="section-sub" wrapText="true"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtLeadershipReason" promptText="Explique por que deseja ser chefe de grupo"
                           styleClass="field-input" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnRequestLeadership" text="Enviar pedido" styleClass="btn, btn-secondary"/>
            </HBox>
        </VBox>

        <!-- ================= TABS ================= -->
        <HBox styleClass="tabs" spacing="25">
            <ToggleButton fx:id="tabContributions" text="Histórico de contribuições" styleClass="tab-btn" toggleGroup="$profileTabs" selected="true"/>
            <ToggleButton fx:id="tabFinished" text="Xitiques finalizados" styleClass="tab-btn" toggleGroup="$profileTabs"/>
        </HBox>

        <!-- Painéis: o controller alterna visible/managed conforme o tab selecionado -->
        <StackPane>
            <!-- 1) Histórico -->
            <VBox fx:id="paneContributions" styleClass="card, table-card">
                <HBox styleClass="t-head">
                    <Label text="DATA" styleClass="t-th, c-w110"/>
                    <Label text="GRUPO" styleClass="t-th" HBox.hgrow="ALWAYS"/>
                    <Label text="VALOR" styleClass="t-th, c-w130"/>
                    <Label text="ESTADO" styleClass="t-th, c-w110"/>
                </HBox>
                <VBox fx:id="profileActivityRows"/>
            </VBox>

            <!-- 2) Finalizados (estado vazio) -->
            <VBox fx:id="paneFinished" styleClass="card, empty-card" alignment="CENTER" spacing="8" visible="false" managed="false">
                <StackPane styleClass="empty-icon">
                    <StackPane styleClass="ico-box"><SVGPath styleClass="ico, ico-lg" content="M5,12 L9,16 L19,6"/></StackPane>
                </StackPane>
                <Label text="Ainda não há xitiques finalizados" styleClass="section-title"/>
                <Label text="Os grupos concluídos serão apresentados aqui." styleClass="section-sub"/>
            </VBox>

        </StackPane>
    </VBox>
</ScrollPane>
