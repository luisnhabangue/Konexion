<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="page-scroll" stylesheets="@app.css"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AdminDashboardController">
    <VBox spacing="18" styleClass="page">
        <VBox spacing="5">
            <Label styleClass="page-title" text="Relatórios da plataforma"/>
            <Label styleClass="page-sub" text="Consulte indicadores de atraso e exporte os dados financeiros de todos os grupos."/>
        </VBox>
        <VBox spacing="12" styleClass="card, admin-section">
            <Label styleClass="section-title" text="Relatório financeiro consolidado"/>
            <Label styleClass="section-sub" text="Seleccione o período para exportar as contribuições confirmadas em CSV ou PDF." wrapText="true"/>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <DatePicker fx:id="reportFrom" promptText="Desde"/>
                <DatePicker fx:id="reportTo" promptText="Até"/>
                <Button fx:id="btnExportCsv" styleClass="btn, btn-primary" text="Exportar CSV"/>
                <Button fx:id="btnExportPdf" styleClass="btn, btn-secondary" text="Exportar PDF"/>
            </HBox>
        </VBox>
        <VBox spacing="10" styleClass="card, admin-section">
            <Label styleClass="section-title" text="Membros com mais atrasos"/>
            <Label styleClass="section-sub" text="Taxa de atraso consolidada entre todos os grupos."/>
            <VBox fx:id="lateMemberRows" spacing="8"/>
        </VBox>
    </VBox>
</ScrollPane>
