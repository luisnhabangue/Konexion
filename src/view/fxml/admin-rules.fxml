<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="page-scroll" stylesheets="@app.css"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AdminDashboardController">
    <VBox spacing="18" styleClass="page">
        <VBox spacing="5">
            <Label styleClass="page-title" text="Regras globais"/>
            <Label styleClass="page-sub" text="Defina regras de penalização e notificações aplicáveis a toda a plataforma."/>
        </VBox>
        <VBox spacing="14" styleClass="card, admin-section">
            <Label styleClass="section-title" text="Penalizações e notificações"/>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Penalização por atraso (pontos)"/>
                <TextField fx:id="penaltyPointsField" prefWidth="90" promptText="10"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Lembrete antes do prazo (dias)"/>
                <TextField fx:id="reminderDaysField" prefWidth="90" promptText="1"/>
            </HBox>
            <VBox spacing="5" styleClass="admin-rule-option">
                <CheckBox fx:id="remindersEnabledCheck" styleClass="global-rule-checkbox"
                          text="Enviar lembretes de prazo"/>
                <Label styleClass="section-sub"
                       text="Envia um aviso antes da data limite de contribuição." wrapText="true"/>
            </VBox>
            <VBox spacing="5" styleClass="admin-rule-option">
                <CheckBox fx:id="overdueNotificationsCheck" styleClass="global-rule-checkbox"
                          text="Notificar responsável sobre atrasos"/>
                <Label styleClass="section-sub"
                       text="Avisa o responsável quando uma contribuição ultrapassa o prazo." wrapText="true"/>
            </VBox>
            <VBox spacing="5" styleClass="admin-rule-option">
                <CheckBox fx:id="latePaymentNotificationsCheck" styleClass="global-rule-checkbox"
                          text="Notificar pagamentos tardios"/>
                <Label styleClass="section-sub"
                       text="Regista e comunica pagamentos efectuados depois da data limite." wrapText="true"/>
            </VBox>
            <Label styleClass="section-sub" text="A penalização aceita 0–100 pontos; o lembrete aceita 0–30 dias."/>
            <HBox alignment="CENTER_RIGHT">
                <Button fx:id="btnSaveSettings" styleClass="btn, btn-primary" text="Guardar regras"/>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
